# Copy to .env and adjust. Never commit the real .env (see .gitignore).

# Which provider adapter to use for live aircraft data.
# One of: mock | replay | adsblol
AVIATION_PROVIDER=mock

# Port the gateway's HTTP/WebSocket server listens on.
PORT=8787

# Host/interface to bind. 0.0.0.0 to be reachable from the Core2/tablet on the LAN.
HOST=0.0.0.0

# Only used when AVIATION_PROVIDER=replay: path to a fixture file under tests/fixtures.
REPLAY_FIXTURE_PATH=tests/fixtures/one-commercial-aircraft.json

# Only used when AVIATION_PROVIDER=adsblol. No key is currently required by
# adsb.lol, but this is here so the adapter never needs a code change if
# that becomes true in the future (see docs/DATA_SOURCE_EVALUATION.md).
ADSBLOL_API_KEY=

# Where device configuration is persisted (JSON file store, Phase 1 only).
DEVICE_STORE_PATH=data/devices.json

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
