<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenFlightDisplay.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:OpenFlightDisplay.App.ViewModels"
    xmlns:ctl="using:OpenFlightDisplay.App.Controls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="OpenFlightDisplay Desktop">

    <muxc:NavigationView
        x:Name="Nav"
        PaneDisplayMode="LeftCompact"
        OpenPaneLength="220"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        SelectionChanged="OnNavSelectionChanged">

        <muxc:NavigationView.MenuItems>
            <muxc:NavigationViewItem Content="Live Radar" Tag="radar" Icon="Map" />
            <muxc:NavigationViewItem Content="Flight Board" Tag="board" Icon="List" />
            <muxc:NavigationViewItem Content="Track Flight" Tag="track" Icon="Send" />
            <muxc:NavigationViewItem Content="History" Tag="history" Icon="Clock" />
            <muxc:NavigationViewItem Content="Alerts" Tag="alerts" Icon="Message" />
            <muxc:NavigationViewItem Content="Monitoring Areas" Tag="areas" Icon="Target" />
            <muxc:NavigationViewItem Content="Devices" Tag="devices" Icon="Cellphone" />
            <muxc:NavigationViewItem Content="Data Sources" Tag="sources" Icon="Globe" />
            <muxc:NavigationViewItem Content="Diagnostics" Tag="diagnostics" Icon="Repair" />
            <muxc:NavigationViewItem Content="Settings" Tag="settings" Icon="Setting" />
        </muxc:NavigationView.MenuItems>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                Status banner. Always present and always worded - every state
                says something specific, and severity is carried by the
                headline text rather than by colour alone.
            -->
            <Border
                x:Name="StatusBanner"
                Grid.Row="0"
                Padding="16,10"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <muxc:ProgressRing
                        Grid.Column="0"
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Width="16" Height="16" VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1">
                        <TextBlock
                            Text="{x:Bind ViewModel.StatusHeadline, Mode=OneWay}"
                            FontWeight="SemiBold"
                            AutomationProperties.LiveSetting="Polite" />
                        <TextBlock
                            Text="{x:Bind ViewModel.StatusDetail, Mode=OneWay}"
                            FontSize="12" TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Button
                        Grid.Column="2"
                        x:Name="CompactButton"
                        Content="Compact"
                        VerticalAlignment="Center"
                        Click="OnToggleCompact"
                        ToolTipService.ToolTip="Shrink to a small always-on-top window showing the nearest aircraft" />
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1">

                <!-- Live Radar -->
                <Grid x:Name="RadarPage" ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ctl:RadarView
                        x:Name="Radar"
                        Grid.Column="0"
                        Aircraft="{x:Bind ViewModel.Aircraft, Mode=OneWay}"
                        RangeKm="{x:Bind ViewModel.RangeKm, Mode=OneWay}"
                        Units="{x:Bind ViewModel.Units, Mode=OneWay}"
                        Trail="{x:Bind ViewModel.SelectedTrail, Mode=OneWay}"
                        ObserverLatitude="{x:Bind ViewModel.ObserverLatitude, Mode=OneWay}"
                        ObserverLongitude="{x:Bind ViewModel.ObserverLongitude, Mode=OneWay}"
                        AircraftSelected="OnAircraftSelected" />

                    <!-- Detail pane -->
                    <Border
                        Grid.Column="1"
                        Width="300"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0"
                        Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                        <ScrollViewer>
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="{x:Bind ViewModel.SelectedAircraft.Callsign, Mode=OneWay}"
                                    FontSize="20" FontWeight="SemiBold"
                                    FontFamily="{StaticResource BoardFontFamily}" />

                                <TextBlock
                                    Text="{x:Bind ViewModel.SelectedAircraft.IcaoHex, Mode=OneWay}"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedAircraft.DetailRegistration, Mode=OneWay}" Style="{StaticResource BoardCellTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedAircraft.DetailType, Mode=OneWay}" Style="{StaticResource BoardCellTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedAircraft.DetailDistance, Mode=OneWay}" Style="{StaticResource BoardCellTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedAircraft.DetailBearing, Mode=OneWay}" Style="{StaticResource BoardCellTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedAircraft.DetailAltitude, Mode=OneWay}" Style="{StaticResource BoardCellTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedAircraft.DetailSpeed, Mode=OneWay}" Style="{StaticResource BoardCellTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedAircraft.DetailVerticalRate, Mode=OneWay}" Style="{StaticResource BoardCellTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedAircraft.DetailSquawk, Mode=OneWay}" Style="{StaticResource BoardCellTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedAircraft.DetailPosition, Mode=OneWay}" Style="{StaticResource BoardCellTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedAircraft.DetailObserved, Mode=OneWay}" Style="{StaticResource BoardCellTextStyle}" />
                                </StackPanel>

                                <!--
                                    Data-quality warnings are shown, not hidden.
                                    Missing enrichment never suppresses an
                                    aircraft, so the gaps are stated instead.
                                -->
                                <TextBlock
                                    Text="{x:Bind ViewModel.SelectedAircraft.DataQualityNote, Mode=OneWay}"
                                    FontSize="12" TextWrapping="Wrap"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <TextBlock
                                    Text="{x:Bind ViewModel.SelectedAircraft.DetailSource, Mode=OneWay}"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                                <Button Content="Close" Click="OnCloseDetail" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Flight Board -->
                <Grid x:Name="BoardPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        Padding="16,8"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <TextBlock Text="Export:" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="CSV" Tag="csv" Click="OnExport" />
                        <Button Content="JSON" Tag="json" Click="OnExport" />
                        <Button Content="GeoJSON" Tag="geojson" Click="OnExport" />
                        <TextBlock x:Name="ExportStatus" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Border
                        Grid.Row="1" Padding="16,8"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="105" />
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CALLSIGN" Style="{StaticResource BoardHeaderTextStyle}" />
                            <TextBlock Grid.Column="1" Text="TYPE" Style="{StaticResource BoardHeaderTextStyle}" />
                            <TextBlock Grid.Column="2" Text="DISTANCE" Style="{StaticResource BoardHeaderTextStyle}" />
                            <TextBlock Grid.Column="3" Text="BEARING" Style="{StaticResource BoardHeaderTextStyle}" />
                            <TextBlock Grid.Column="4" Text="ALTITUDE" Style="{StaticResource BoardHeaderTextStyle}" />
                            <TextBlock Grid.Column="5" Text="SPEED" Style="{StaticResource BoardHeaderTextStyle}" />
                            <TextBlock Grid.Column="6" Text="TREND" Style="{StaticResource BoardHeaderTextStyle}" />
                            <TextBlock Grid.Column="7" Text="AGE" Style="{StaticResource BoardHeaderTextStyle}" />
                        </Grid>
                    </Border>

                    <!-- ListView virtualises rows, which is what makes hundreds viable. -->
                    <ListView
                        Grid.Row="2"
                        ItemsSource="{x:Bind ViewModel.Aircraft, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedAircraft, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AircraftRowViewModel">
                                <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind AccessibleDescription}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="105" />
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Callsign}" Style="{StaticResource BoardCellTextStyle}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind AircraftType}" Style="{StaticResource BoardCellTextStyle}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Distance}" Style="{StaticResource BoardCellTextStyle}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Bearing}" Style="{StaticResource BoardCellTextStyle}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Altitude}" Style="{StaticResource BoardCellTextStyle}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind GroundSpeed}" Style="{StaticResource BoardCellTextStyle}" />
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind TrendGlyph}" Style="{StaticResource BoardCellTextStyle}" />
                                        <TextBlock Text="{x:Bind TrendLabel}" Style="{StaticResource BoardCellTextStyle}" />
                                        <TextBlock Text="{x:Bind EmergencyLabel}" Style="{StaticResource BoardCellTextStyle}" FontWeight="Bold" Visibility="{x:Bind HasEmergency}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="7" Text="{x:Bind Age}" Style="{StaticResource BoardCellTextStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!--
                    Compact mode. Its own page rather than a second window: one
                    window means one feed, one history connection and one place
                    for the tracked flight to live.
                -->
                <Grid x:Name="CompactPage" Visibility="Collapsed" Padding="14,10" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="CompactHeadline"
                            FontSize="18" FontWeight="SemiBold"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="CompactDetail"
                            FontSize="12" TextTrimming="CharacterEllipsis"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            x:Name="CompactTracked"
                            FontSize="12" TextTrimming="CharacterEllipsis"
                            Visibility="Collapsed"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock
                            x:Name="CompactAttribution"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="{x:Bind ViewModel.ProviderAttribution, Mode=OneWay}" />
                    </StackPanel>

                    <!--
                        The only way out of compact mode: the status banner that
                        normally carries the toggle is hidden here, so this
                        button must exist or the window cannot be restored.
                    -->
                    <Button
                        Grid.Column="1"
                        Content="Expand"
                        VerticalAlignment="Center"
                        Click="OnToggleCompact" />
                </Grid>

                <!-- Monitoring Areas -->
                <ScrollViewer x:Name="AreasPage" Visibility="Collapsed">
                    <StackPanel Padding="24" Spacing="14" MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Text="Monitoring Area" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="What counts as nearby. Everything outside this is discarded before ranking, so it never reaches the board, the radar, alerts or history." />

                        <ComboBox x:Name="AreaShapeBox" Header="Shape" MinWidth="240"
                                  SelectionChanged="OnAreaShapeChanged">
                            <ComboBoxItem Content="Circle — everything within a radius" Tag="Circle" />
                            <ComboBoxItem Content="Cone — a wedge in one direction" Tag="Cone" />
                            <ComboBoxItem Content="Polygon — an outline you define" Tag="Polygon" />
                        </ComboBox>

                        <StackPanel x:Name="AreaCentrePanel" Spacing="12">
                            <TextBox x:Name="AreaRadiusBox" Header="Radius (km)" Width="180" />
                            <CheckBox x:Name="AreaUseHomeCheck" Content="Centre on my home location"
                                      Checked="OnAreaCentreToggled" Unchecked="OnAreaCentreToggled" />
                            <StackPanel x:Name="AreaCentreCoords" Orientation="Horizontal" Spacing="12">
                                <TextBox x:Name="AreaLatBox" Header="Centre latitude" Width="160" />
                                <TextBox x:Name="AreaLonBox" Header="Centre longitude" Width="160" />
                            </StackPanel>
                            <TextBlock
                                FontSize="12" TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="Centring on home means moving home moves the area, rather than leaving it over your old address." />
                        </StackPanel>

                        <StackPanel x:Name="AreaConePanel" Spacing="12" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBox x:Name="AreaHeadingBox" Header="Facing (° true)" Width="160" />
                                <TextBox x:Name="AreaWidthBox" Header="Width (°)" Width="160" />
                            </StackPanel>
                            <TextBlock
                                FontSize="12" TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="0° is north, 90° east. A 90° width centred on 90° covers everything from northeast to southeast." />
                        </StackPanel>

                        <StackPanel x:Name="AreaPolygonPanel" Spacing="12" Visibility="Collapsed">
                            <TextBox
                                x:Name="AreaVerticesBox"
                                Header="Outline points, one per line as latitude, longitude"
                                AcceptsReturn="True"
                                TextWrapping="Wrap"
                                Height="140"
                                PlaceholderText="47.5, -122.5&#x0a;47.7, -122.5&#x0a;47.7, -122.1" />
                            <TextBlock
                                FontSize="12" TextWrapping="Wrap"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="Between 3 and 64 points. The outline closes itself, so do not repeat the first point. A map-based editor is not built yet." />
                        </StackPanel>

                        <TextBlock Text="Altitude band" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBox x:Name="AreaMinAltBox" Header="Above (ft)" Width="160" />
                            <TextBox x:Name="AreaMaxAltBox" Header="Below (ft)" Width="160" />
                        </StackPanel>
                        <TextBlock
                            FontSize="12" TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="Leave blank for no limit. An aircraft that never reported an altitude is kept, because unknown is not zero." />

                        <Button Content="Save area and restart feed" Click="OnSaveArea"
                                Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" />

                        <InfoBar x:Name="AreaError" IsOpen="False" IsClosable="False" Severity="Error" />
                        <TextBlock
                            x:Name="AreaSummary"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Diagnostics -->
                <ScrollViewer x:Name="DiagnosticsPage" Visibility="Collapsed">
                    <StackPanel Padding="24" Spacing="14" MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="Diagnostics" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="What the application is actually doing. Counters that should be zero are called out rather than left for you to notice." />

                        <Button Content="Refresh" Click="OnRefreshDiagnostics" HorizontalAlignment="Left" />

                        <InfoBar
                            x:Name="DiagnosticsWarning"
                            IsOpen="False"
                            IsClosable="False"
                            Severity="Warning" />

                        <TextBlock Text="Feed" FontWeight="SemiBold" />
                        <TextBlock x:Name="DiagFeed" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="History" FontWeight="SemiBold" />
                        <TextBlock x:Name="DiagHistory" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="Alerts" FontWeight="SemiBold" />
                        <TextBlock x:Name="DiagAlerts" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="Flight tracking" FontWeight="SemiBold" />
                        <TextBlock x:Name="DiagTracking" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="Recording" FontWeight="SemiBold" />
                        <TextBlock x:Name="DiagRecording" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="Environment" FontWeight="SemiBold" />
                        <TextBlock x:Name="DiagEnvironment" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Button Content="Copy all to clipboard" Click="OnCopyDiagnostics" HorizontalAlignment="Left" />
                        <TextBlock
                            x:Name="DiagCopyStatus"
                            FontSize="12" TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="Copying includes no coordinates and no callsigns — only counters, versions and paths." />
                    </StackPanel>
                </ScrollViewer>

                <!-- History -->
                <Grid x:Name="HistoryPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Padding="24,20,24,12" Spacing="10">
                        <TextBlock Text="History" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="HistorySummary"
                            TextWrapping="Wrap" MaxWidth="720" HorizontalAlignment="Left"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ComboBox
                                x:Name="HistoryRangeBox"
                                Header="Period"
                                MinWidth="180"
                                SelectionChanged="OnHistoryRangeChanged">
                                <!--
                                    No IsSelected here. Setting it in markup raises
                                    SelectionChanged while InitializeComponent is still
                                    running, so the handler runs against controls that do
                                    not exist yet and the app dies at startup with a
                                    stowed E_POINTER. The default is chosen in the
                                    constructor instead.
                                -->
                                <ComboBoxItem Content="Last hour" Tag="1" />
                                <ComboBoxItem Content="Last 24 hours" Tag="24" />
                                <ComboBoxItem Content="Last 7 days" Tag="168" />
                                <ComboBoxItem Content="Last 30 days" Tag="720" />
                            </ComboBox>
                            <Button Content="Refresh" Click="OnRefreshHistory" VerticalAlignment="Bottom" />
                            <Button Content="Delete all history" Click="OnDeleteHistory" VerticalAlignment="Bottom" />
                        </StackPanel>

                        <TextBlock
                            x:Name="HistoryStatusLine"
                            TextWrapping="Wrap" FontSize="12" MaxWidth="720"
                            HorizontalAlignment="Left"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>

                    <ListView
                        Grid.Row="1"
                        x:Name="HistoryList"
                        SelectionMode="Single"
                        SelectionChanged="OnHistorySelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="16,8" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:HistoryRowViewModel">
                                <Grid ColumnSpacing="16"
                                      AutomationProperties.Name="{x:Bind AccessibleDescription}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Callsign}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind IcaoHex}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Observations}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Seen}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <Button Grid.Column="4" Content="Export trail"
                                            AutomationProperties.Name="{x:Bind ExportAccessibleName}"
                                            Tag="{x:Bind IcaoHex}" Click="OnExportTrail" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Track Flight -->
                <ScrollViewer x:Name="TrackPage" Visibility="Collapsed">
                    <StackPanel Padding="24" Spacing="16" MaxWidth="680" HorizontalAlignment="Left">
                        <TextBlock Text="Track Flight" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Follow one flight to its destination and be told when to leave to collect someone. Polling speeds up as the flight gets closer and stays slow while it is hours away." />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBox
                                x:Name="TrackCallsignBox"
                                Header="Flight number or callsign"
                                PlaceholderText="UA1234"
                                Width="200" />
                            <TextBox
                                x:Name="TrackDestinationBox"
                                Header="Destination (ICAO)"
                                PlaceholderText="KSEA"
                                MaxLength="4"
                                Width="160" />
                        </StackPanel>

                        <TextBlock
                            FontSize="12" TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="UA1234, ua 1234 and UA-1234 all resolve to the ICAO callsign UAL1234. The destination must be the four-letter ICAO code (KSEA), not the three-letter IATA one (SEA)." />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBox
                                x:Name="TrackTravelBox"
                                Header="Your travel time (minutes)"
                                PlaceholderText="45"
                                Width="200" />
                            <TextBox
                                x:Name="TrackWalkOutBox"
                                Header="Landing to walk-out (minutes)"
                                PlaceholderText="20"
                                Width="220" />
                        </StackPanel>

                        <TextBlock
                            FontSize="12" TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="Walk-out covers taxi, deplaning, immigration and bags. It matters: on a long-haul arrival that gap is routinely longer than the drive, and leaving it out sends you to the airport half an hour early." />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="TrackStartButton" Content="Start tracking"
                                    Style="{StaticResource AccentButtonStyle}" Click="OnStartTracking" />
                            <Button x:Name="TrackStopButton" Content="Stop" Click="OnStopTracking" />
                        </StackPanel>

                        <InfoBar
                            x:Name="TrackError"
                            IsOpen="False"
                            IsClosable="False"
                            Severity="Error" />

                        <!-- Live state -->
                        <Border
                            x:Name="TrackStatusCard"
                            Visibility="Collapsed"
                            Background="{ThemeResource LayerFillColorAltBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="20">
                            <StackPanel Spacing="12">
                                <TextBlock x:Name="TrackFlightLabel" FontSize="18" FontWeight="SemiBold" />

                                <StackPanel Orientation="Horizontal" Spacing="32">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="STATUS" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock x:Name="TrackPhase" FontSize="26" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="ETA (MIN)" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock x:Name="TrackEta" FontSize="26" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="DISTANCE" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                        <TextBlock x:Name="TrackDistance" FontSize="26" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>

                                <Border
                                    x:Name="TrackAdviceCard"
                                    Visibility="Collapsed"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                                    CornerRadius="6"
                                    Padding="14,10">
                                    <StackPanel Spacing="2">
                                        <TextBlock x:Name="TrackAdvice" FontSize="20" FontWeight="SemiBold" />
                                        <TextBlock
                                            x:Name="TrackAdviceDetail"
                                            FontSize="12" TextWrapping="Wrap"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    x:Name="TrackDestinationLabel"
                                    FontSize="12" TextWrapping="Wrap"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <TextBlock
                                    x:Name="TrackContactLabel"
                                    FontSize="12" TextWrapping="Wrap"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Border>

                        <InfoBar
                            x:Name="TrackDestinationIssue"
                            IsOpen="False"
                            IsClosable="False"
                            Severity="Warning" />

                        <InfoBar
                            x:Name="TrackFeedIssue"
                            IsOpen="False"
                            IsClosable="False"
                            Severity="Informational" />

                        <TextBlock
                            FontSize="12" TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="Tracking uses adsb.lol regardless of the data source selected for the radar, because it is the only configured source with a callsign lookup. ETA is a straight-line projection from the current groundspeed — it is not a schedule, and it knows nothing about routing, holding or taxi time." />
                    </StackPanel>
                </ScrollViewer>

                <!-- Alerts -->
                <Grid x:Name="AlertsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Padding="24,20,24,12" Spacing="10">
                        <TextBlock Text="Alerts" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="AlertsSummary"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="Rules" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Button Content="Add rule" Click="OnAddAlertRule" />
                        </StackPanel>

                        <ItemsControl x:Name="RulesList" MaxWidth="720" HorizontalAlignment="Left">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AlertRuleViewModel">
                                    <Border
                                        Background="{ThemeResource LayerFillColorAltBrush}"
                                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6"
                                        Padding="12,8" Margin="0,0,0,6">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ToggleSwitch
                                                Grid.Column="0"
                                                IsOn="{x:Bind Enabled}"
                                                OnContent="" OffContent=""
                                                MinWidth="44"
                                                AutomationProperties.Name="{x:Bind ToggleAccessibleName}"
                                                Toggled="OnAlertRuleToggled"
                                                Tag="{x:Bind Id}"
                                                VerticalAlignment="Center" />

                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" />
                                                <TextBlock
                                                    Text="{x:Bind Summary}"
                                                    FontSize="12" TextWrapping="Wrap"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <Button Grid.Column="2" Content="Edit"
                                                    AutomationProperties.Name="{x:Bind EditAccessibleName}"
                                                    Tag="{x:Bind Id}" Click="OnEditAlertRule"
                                                    VerticalAlignment="Center" />
                                            <Button Grid.Column="3" Content="Delete"
                                                    AutomationProperties.Name="{x:Bind DeleteAccessibleName}"
                                                    Tag="{x:Bind Id}" Click="OnDeleteAlertRule"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock
                            x:Name="NoRulesNote"
                            Visibility="Collapsed"
                            TextWrapping="Wrap" FontSize="12" MaxWidth="620"
                            HorizontalAlignment="Left"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="No rules are configured, so nothing will alert. Add one above." />

                        <TextBlock
                            Text="Recent alerts" FontWeight="SemiBold" Margin="0,6,0,0" />
                    </StackPanel>

                    <ListView Grid.Row="1" x:Name="AlertsList" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="16,8" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>

                <!-- Data Sources -->
                <ScrollViewer x:Name="SourcesPage" Visibility="Collapsed">
                    <StackPanel Padding="24" Spacing="16" MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Text="Data Sources" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Choose where aircraft data comes from. The selection is saved and restored on the next launch." />

                        <ListView
                            x:Name="SourceList"
                            SelectionMode="Single"
                            SelectionChanged="OnDataSourceChanged">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="12,10" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <TextBlock
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="adsb.lol is a free, community-funded service. The app identifies itself, caps its request radius at 250 NM and backs off when rate limited." />

                        <TextBlock Text="Recordings" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock
                            TextWrapping="Wrap" FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Capture a live session to a file, then select Replay to play it back. Useful for demos and for reproducing a problem against the exact data that caused it." />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="RecordButton" Content="Start recording" Click="OnToggleRecording" />
                            <Button Content="Load recording…" Click="OnLoadRecording" />
                        </StackPanel>

                        <TextBlock
                            x:Name="RecordingStatus"
                            TextWrapping="Wrap" FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Settings -->
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed">
                    <StackPanel Padding="24" Spacing="16" MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />

                        <TextBlock Text="Units" FontWeight="SemiBold" />
                        <!--
                            A neighbouring TextBlock is not an accessible name. A
                            screen reader announces this as an unlabelled combo
                            box without it, and the visible heading above is a
                            separate element it has no relationship to.
                        -->
                        <ComboBox x:Name="UnitsBox" MinWidth="240"
                                  AutomationProperties.Name="Units"
                                  SelectionChanged="OnUnitsChanged">
                            <ComboBoxItem Content="Aviation (NM, ft, kt)" Tag="Aviation" />
                            <ComboBoxItem Content="Metric (km, m, km/h)" Tag="Metric" />
                            <ComboBoxItem Content="Imperial (mi, ft, mph)" Tag="Imperial" />
                        </ComboBox>

                        <TextBlock Text="Order the board by" FontWeight="SemiBold" />
                        <ComboBox x:Name="RankingBox" MinWidth="280"
                                  AutomationProperties.Name="Order the board by"
                                  SelectionChanged="OnRankingChanged">
                            <ComboBoxItem Content="Nearest (horizontal distance)" Tag="NearestHorizontal" />
                            <ComboBoxItem Content="Nearest (slant range, includes altitude)" Tag="NearestSlantRange" />
                            <ComboBoxItem Content="Lowest altitude" Tag="LowestAltitude" />
                            <ComboBoxItem Content="Highest altitude" Tag="HighestAltitude" />
                            <ComboBoxItem Content="Fastest" Tag="Fastest" />
                            <ComboBoxItem Content="Most recently seen" Tag="NewestObservation" />
                            <ComboBoxItem Content="Emergencies first, then nearest" Tag="EmergencyPriority" />
                        </ComboBox>
                        <TextBlock
                            FontSize="12" TextWrapping="Wrap" MaxWidth="480"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="Slant range counts altitude, so an airliner directly overhead at 36,000 ft is about 11 km away rather than zero." />

                        <TextBlock Text="Show only" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBox x:Name="MinAltBox" Header="Above (ft)" Width="140" />
                            <TextBox x:Name="MaxAltBox" Header="Below (ft)" Width="140" />
                        </StackPanel>
                        <CheckBox x:Name="AirborneOnlyCheck" Content="Airborne only (hide ground traffic)" />
                        <CheckBox x:Name="RequireCallsignCheck" Content="Only aircraft transmitting a callsign" />
                        <CheckBox x:Name="EmergencyOnlyCheck" Content="Emergencies only" />
                        <TextBlock
                            FontSize="12" TextWrapping="Wrap" MaxWidth="480"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="An aircraft that never reported its altitude is never hidden by an altitude filter — unknown is not zero. Leave a box blank for no limit." />

                        <TextBlock Text="Home location" FontWeight="SemiBold" />
                        <TextBlock
                            FontSize="12" TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Used only to ask your chosen provider what is nearby. It is never sent anywhere else." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox
                                x:Name="PlaceSearchBox"
                                Header="Find by postcode or place"
                                PlaceholderText="98101, or Seattle, or KSEA"
                                Width="300"
                                KeyDown="OnPlaceSearchKeyDown" />
                            <Button
                                x:Name="PlaceSearchButton"
                                Content="Search"
                                VerticalAlignment="Bottom"
                                Click="OnSearchPlace" />
                        </StackPanel>

                        <ListView
                            x:Name="PlaceResults"
                            Visibility="Collapsed"
                            MaxHeight="180"
                            MaxWidth="520"
                            HorizontalAlignment="Left"
                            SelectionMode="Single"
                            SelectionChanged="OnPlaceChosen">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="10,6" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <TextBlock
                            x:Name="PlaceSearchStatus"
                            FontSize="12" TextWrapping="Wrap" MaxWidth="520"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="Optional. Looks the place up with OpenStreetMap and fills in the coordinates below — the search text is sent, nothing else. You can always type coordinates directly." />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBox x:Name="LatBox" Header="Latitude" Width="160" />
                            <TextBox x:Name="LonBox" Header="Longitude" Width="160" />
                            <TextBox x:Name="RadiusBox" Header="Radius (km)" Width="140" />
                        </StackPanel>

                        <TextBlock Text="Local ADS-B receiver" FontWeight="SemiBold" />
                        <TextBlock
                            FontSize="12" TextWrapping="Wrap" MaxWidth="480"
                            HorizontalAlignment="Left"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Used when the Local ADS-B receiver data source is selected. A bare host is enough — the common dump1090, readsb and tar1090 paths are tried automatically." />
                        <TextBox
                            x:Name="ReceiverUrlBox"
                            Header="Receiver URL"
                            Width="320"
                            HorizontalAlignment="Left"
                            PlaceholderText="http://192.168.1.10" />

                        <TextBlock Text="Map backdrop" FontWeight="SemiBold" />
                        <CheckBox x:Name="MapCheck"
                                  AutomationProperties.Name="Show a map under the radar"
                                  Checked="OnMapToggled" Unchecked="OnMapToggled">
                            <StackPanel>
                                <TextBlock Text="Show a map under the radar" />
                                <TextBlock
                                    TextWrapping="Wrap" MaxWidth="420" FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Draws OpenStreetMap tiles beneath the range rings so you can see what is underneath. Off by default: asking for tiles around your home tells the tile server roughly where you live, which is the one thing this app otherwise never does." />
                            </StackPanel>
                        </CheckBox>
                        <TextBlock
                            x:Name="MapCacheStatus"
                            FontSize="12" TextWrapping="Wrap" MaxWidth="480"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Button Content="Clear map cache" Click="OnClearMapCache" HorizontalAlignment="Left" />

                        <TextBlock Text="Flight history" FontWeight="SemiBold" />
                        <!--
                            A CheckBox whose content is a panel rather than a
                            string exposes no accessible name at all.
                        -->
                        <CheckBox x:Name="HistoryCheck"
                                  AutomationProperties.Name="Record observations locally"
                                  Checked="OnHistoryToggled" Unchecked="OnHistoryToggled">
                            <StackPanel>
                                <TextBlock Text="Record observations locally" />
                                <TextBlock
                                    TextWrapping="Wrap" MaxWidth="420" FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Enables aircraft trails on the radar and keeps a local record of what was observed. Stored on this machine only, pruned by age and size." />
                            </StackPanel>
                        </CheckBox>
                        <TextBlock
                            x:Name="HistoryStatus"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                        <TextBlock
                            x:Name="SettingsError"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Save and restart feed" Click="OnSaveSettings" />
                            <TextBlock
                                x:Name="SettingsSaved"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="Collapsed"
                                Text="Saved." />
                        </StackPanel>

                        <TextBlock
                            FontSize="12" TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="Settings are written atomically, so an interrupted save cannot corrupt the existing file — a failed write loses the new settings, never the old ones." />
                    </StackPanel>
                </ScrollViewer>

                <!--
                    Pages that are genuinely not built yet say so plainly, with
                    the phase they are planned for. A blank page implying work
                    that does not exist would be worse than an honest note.
                -->
                <StackPanel
                    x:Name="NotBuiltPage"
                    Visibility="Collapsed"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="8" MaxWidth="460">
                    <TextBlock x:Name="NotBuiltTitle" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock
                        x:Name="NotBuiltDetail"
                        TextWrapping="Wrap" TextAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- Attribution: the active provider is always visible, never implicit. -->
            <Border
                x:Name="AttributionBar"
                Grid.Row="2" Padding="16,8"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock
                        Text="{x:Bind ViewModel.ProviderAttribution, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                    <!--
                        Required by OpenStreetMap's licence wherever its imagery
                        is shown. Visible exactly when the backdrop is drawn.
                    -->
                    <TextBlock
                        Text="Map data © OpenStreetMap contributors"
                        Visibility="{x:Bind ViewModel.MapAttributionVisible, Mode=OneWay}"
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>
    </muxc:NavigationView>
</Window>
