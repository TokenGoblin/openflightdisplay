<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OpenFlightDisplay.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:OpenFlightDisplay.App.ViewModels"
    xmlns:ctl="using:OpenFlightDisplay.App.Controls"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="OpenFlightDisplay Desktop">

    <muxc:NavigationView
        x:Name="Nav"
        PaneDisplayMode="LeftCompact"
        OpenPaneLength="220"
        IsBackButtonVisible="Collapsed"
        IsSettingsVisible="False"
        SelectionChanged="OnNavSelectionChanged">

        <muxc:NavigationView.MenuItems>
            <muxc:NavigationViewItem Content="Live Radar" Tag="radar" Icon="Map" />
            <muxc:NavigationViewItem Content="Flight Board" Tag="board" Icon="List" />
            <muxc:NavigationViewItem Content="Track Flight" Tag="track" Icon="Send" />
            <muxc:NavigationViewItem Content="History" Tag="history" Icon="Clock" />
            <muxc:NavigationViewItem Content="Alerts" Tag="alerts" Icon="Message" />
            <muxc:NavigationViewItem Content="Monitoring Areas" Tag="areas" Icon="Target" />
            <muxc:NavigationViewItem Content="Devices" Tag="devices" Icon="Cellphone" />
            <muxc:NavigationViewItem Content="Data Sources" Tag="sources" Icon="Globe" />
            <muxc:NavigationViewItem Content="Diagnostics" Tag="diagnostics" Icon="Repair" />
            <muxc:NavigationViewItem Content="Settings" Tag="settings" Icon="Setting" />
        </muxc:NavigationView.MenuItems>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                Status banner. Always present and always worded - every state
                says something specific, and severity is carried by the
                headline text rather than by colour alone.
            -->
            <Border
                Grid.Row="0"
                Padding="16,10"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <muxc:ProgressRing
                        IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                        Width="16" Height="16" VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock
                            Text="{x:Bind ViewModel.StatusHeadline, Mode=OneWay}"
                            FontWeight="SemiBold"
                            AutomationProperties.LiveSetting="Polite" />
                        <TextBlock
                            Text="{x:Bind ViewModel.StatusDetail, Mode=OneWay}"
                            FontSize="12" TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1">

                <!-- Live Radar -->
                <Grid x:Name="RadarPage" ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ctl:RadarView
                        x:Name="Radar"
                        Grid.Column="0"
                        Aircraft="{x:Bind ViewModel.Aircraft, Mode=OneWay}"
                        RangeKm="{x:Bind ViewModel.RangeKm, Mode=OneWay}"
                        Units="{x:Bind ViewModel.Units, Mode=OneWay}"
                        Trail="{x:Bind ViewModel.SelectedTrail, Mode=OneWay}"
                        ObserverLatitude="{x:Bind ViewModel.ObserverLatitude, Mode=OneWay}"
                        ObserverLongitude="{x:Bind ViewModel.ObserverLongitude, Mode=OneWay}"
                        AircraftSelected="OnAircraftSelected" />

                    <!-- Detail pane -->
                    <Border
                        Grid.Column="1"
                        Width="300"
                        Padding="16"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="1,0,0,0"
                        Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                        <ScrollViewer>
                            <StackPanel Spacing="10">
                                <TextBlock
                                    Text="{x:Bind ViewModel.SelectedAircraft.Callsign, Mode=OneWay}"
                                    FontSize="20" FontWeight="SemiBold"
                                    FontFamily="{StaticResource BoardFontFamily}" />

                                <TextBlock
                                    Text="{x:Bind ViewModel.SelectedAircraft.IcaoHex, Mode=OneWay}"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <StackPanel Spacing="6">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedAircraft.DetailRegistration, Mode=OneWay}" Style="{StaticResource BoardCellTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedAircraft.DetailType, Mode=OneWay}" Style="{StaticResource BoardCellTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedAircraft.DetailDistance, Mode=OneWay}" Style="{StaticResource BoardCellTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedAircraft.DetailBearing, Mode=OneWay}" Style="{StaticResource BoardCellTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedAircraft.DetailAltitude, Mode=OneWay}" Style="{StaticResource BoardCellTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedAircraft.DetailSpeed, Mode=OneWay}" Style="{StaticResource BoardCellTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedAircraft.DetailVerticalRate, Mode=OneWay}" Style="{StaticResource BoardCellTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedAircraft.DetailSquawk, Mode=OneWay}" Style="{StaticResource BoardCellTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedAircraft.DetailPosition, Mode=OneWay}" Style="{StaticResource BoardCellTextStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedAircraft.DetailObserved, Mode=OneWay}" Style="{StaticResource BoardCellTextStyle}" />
                                </StackPanel>

                                <!--
                                    Data-quality warnings are shown, not hidden.
                                    Missing enrichment never suppresses an
                                    aircraft, so the gaps are stated instead.
                                -->
                                <TextBlock
                                    Text="{x:Bind ViewModel.SelectedAircraft.DataQualityNote, Mode=OneWay}"
                                    FontSize="12" TextWrapping="Wrap"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <TextBlock
                                    Text="{x:Bind ViewModel.SelectedAircraft.DetailSource, Mode=OneWay}"
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                                <Button Content="Close" Click="OnCloseDetail" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Flight Board -->
                <Grid x:Name="BoardPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        Padding="16,8"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <TextBlock Text="Export:" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Content="CSV" Tag="csv" Click="OnExport" />
                        <Button Content="JSON" Tag="json" Click="OnExport" />
                        <Button Content="GeoJSON" Tag="geojson" Click="OnExport" />
                        <TextBlock x:Name="ExportStatus" VerticalAlignment="Center" FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <Border
                        Grid.Row="1" Padding="16,8"
                        Background="{ThemeResource LayerFillColorAltBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="105" />
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="CALLSIGN" Style="{StaticResource BoardHeaderTextStyle}" />
                            <TextBlock Grid.Column="1" Text="TYPE" Style="{StaticResource BoardHeaderTextStyle}" />
                            <TextBlock Grid.Column="2" Text="DISTANCE" Style="{StaticResource BoardHeaderTextStyle}" />
                            <TextBlock Grid.Column="3" Text="BEARING" Style="{StaticResource BoardHeaderTextStyle}" />
                            <TextBlock Grid.Column="4" Text="ALTITUDE" Style="{StaticResource BoardHeaderTextStyle}" />
                            <TextBlock Grid.Column="5" Text="SPEED" Style="{StaticResource BoardHeaderTextStyle}" />
                            <TextBlock Grid.Column="6" Text="TREND" Style="{StaticResource BoardHeaderTextStyle}" />
                            <TextBlock Grid.Column="7" Text="AGE" Style="{StaticResource BoardHeaderTextStyle}" />
                        </Grid>
                    </Border>

                    <!-- ListView virtualises rows, which is what makes hundreds viable. -->
                    <ListView
                        Grid.Row="2"
                        ItemsSource="{x:Bind ViewModel.Aircraft, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedAircraft, Mode=TwoWay}"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="8,4" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:AircraftRowViewModel">
                                <Grid ColumnSpacing="12" AutomationProperties.Name="{x:Bind AccessibleDescription}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="105" />
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition Width="95" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Callsign}" Style="{StaticResource BoardCellTextStyle}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind AircraftType}" Style="{StaticResource BoardCellTextStyle}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Distance}" Style="{StaticResource BoardCellTextStyle}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Bearing}" Style="{StaticResource BoardCellTextStyle}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Altitude}" Style="{StaticResource BoardCellTextStyle}" />
                                    <TextBlock Grid.Column="5" Text="{x:Bind GroundSpeed}" Style="{StaticResource BoardCellTextStyle}" />
                                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind TrendGlyph}" Style="{StaticResource BoardCellTextStyle}" />
                                        <TextBlock Text="{x:Bind TrendLabel}" Style="{StaticResource BoardCellTextStyle}" />
                                        <TextBlock Text="{x:Bind EmergencyLabel}" Style="{StaticResource BoardCellTextStyle}" FontWeight="Bold" Visibility="{x:Bind HasEmergency}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="7" Text="{x:Bind Age}" Style="{StaticResource BoardCellTextStyle}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- Alerts -->
                <Grid x:Name="AlertsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Padding="24,20,24,12" Spacing="8">
                        <TextBlock Text="Alerts" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock
                            x:Name="AlertsSummary"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            TextWrapping="Wrap" FontSize="12" MaxWidth="620"
                            HorizontalAlignment="Left"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="One built-in rule is active: emergency squawks, with a 15 minute cooldown per aircraft. A rule editor is not built yet, so no other rules can be added." />
                    </StackPanel>

                    <ListView Grid.Row="1" x:Name="AlertsList" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="16,8" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>

                <!-- Data Sources -->
                <ScrollViewer x:Name="SourcesPage" Visibility="Collapsed">
                    <StackPanel Padding="24" Spacing="16" MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Text="Data Sources" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Choose where aircraft data comes from. The selection is saved and restored on the next launch." />

                        <ListView
                            x:Name="SourceList"
                            SelectionMode="Single"
                            SelectionChanged="OnDataSourceChanged">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="12,10" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>

                        <TextBlock
                            TextWrapping="Wrap"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="adsb.lol is a free, community-funded service. The app identifies itself, caps its request radius at 250 NM and backs off when rate limited." />
                    </StackPanel>
                </ScrollViewer>

                <!-- Settings -->
                <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed">
                    <StackPanel Padding="24" Spacing="16" MaxWidth="620" HorizontalAlignment="Left">
                        <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" />

                        <TextBlock Text="Units" FontWeight="SemiBold" />
                        <ComboBox x:Name="UnitsBox" MinWidth="240" SelectionChanged="OnUnitsChanged">
                            <ComboBoxItem Content="Aviation (NM, ft, kt)" Tag="Aviation" />
                            <ComboBoxItem Content="Metric (km, m, km/h)" Tag="Metric" />
                            <ComboBoxItem Content="Imperial (mi, ft, mph)" Tag="Imperial" />
                        </ComboBox>

                        <TextBlock Text="Home location" FontWeight="SemiBold" />
                        <TextBlock
                            FontSize="12" TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Used only to ask your chosen provider what is nearby. It is never sent anywhere else." />
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBox x:Name="LatBox" Header="Latitude" Width="160" />
                            <TextBox x:Name="LonBox" Header="Longitude" Width="160" />
                            <TextBox x:Name="RadiusBox" Header="Radius (km)" Width="140" />
                        </StackPanel>

                        <TextBlock Text="Flight history" FontWeight="SemiBold" />
                        <CheckBox x:Name="HistoryCheck" Checked="OnHistoryToggled" Unchecked="OnHistoryToggled">
                            <StackPanel>
                                <TextBlock Text="Record observations locally" />
                                <TextBlock
                                    TextWrapping="Wrap" MaxWidth="420" FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Enables aircraft trails on the radar and keeps a local record of what was observed. Stored on this machine only, pruned by age and size." />
                            </StackPanel>
                        </CheckBox>
                        <TextBlock
                            x:Name="HistoryStatus"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                        <TextBlock
                            x:Name="SettingsError"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Save and restart feed" Click="OnSaveSettings" />
                            <TextBlock
                                x:Name="SettingsSaved"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Visibility="Collapsed"
                                Text="Saved." />
                        </StackPanel>

                        <TextBlock
                            FontSize="12" TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Text="History and notifications are not implemented yet and remain off. Settings are written atomically, so an interrupted save cannot corrupt the existing file." />
                    </StackPanel>
                </ScrollViewer>

                <!--
                    Pages that are genuinely not built yet say so plainly, with
                    the phase they are planned for. A blank page implying work
                    that does not exist would be worse than an honest note.
                -->
                <StackPanel
                    x:Name="NotBuiltPage"
                    Visibility="Collapsed"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    Spacing="8" MaxWidth="460">
                    <TextBlock x:Name="NotBuiltTitle" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock
                        x:Name="NotBuiltDetail"
                        TextWrapping="Wrap" TextAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <!-- Attribution: the active provider is always visible, never implicit. -->
            <Border
                Grid.Row="2" Padding="16,8"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <TextBlock
                    Text="{x:Bind ViewModel.ProviderAttribution, Mode=OneWay}"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>
        </Grid>
    </muxc:NavigationView>
</Window>
