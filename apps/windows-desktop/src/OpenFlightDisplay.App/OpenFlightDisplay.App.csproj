<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>OpenFlightDisplay.App</RootNamespace>

    <!--
      A DPI-awareness-only manifest. It must stay minimal: declaring an
      assemblyIdentity or supportedOS here replaces what the Windows App SDK
      generates for an unpackaged WinUI app and breaks startup. See the comments
      in app.manifest.
    -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!--
      x64 and ARM64 only. Leaving x86 in Platforms while shipping only
      win-x64/win-arm64 runtime identifiers makes a solution-level build fail
      with NETSDK1032, because the default platform is resolved before the RID.
    -->
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!--
      Unpackaged by default so `dotnet run` works during development without
      deploying an MSIX. The packaging targets override this to MSIX; see
      docs/WINDOWS_DESKTOP.md.
    -->
    <WindowsPackageType>None</WindowsPackageType>

    <!--
      Self-contained so an unpackaged dev build runs without the Windows App
      Runtime being installed separately.

      NOTE: framework-dependent deployment was tried as a fix for the DPI
      scaling defect described in docs/WINDOWS_DESKTOP.md and made no
      difference, so this is chosen on distribution grounds alone.
    -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      CA1812 fires on view models and pages that only the DI container and the
      XAML loader construct. The analyzer cannot see either, so every one of
      those reports is a false positive.
    -->
    <NoWarn>$(NoWarn);CA1812</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      CsWinRT is intentionally NOT referenced explicitly. Microsoft.WindowsAppSDK
      brings the matching version transitively and configures it; adding a direct
      reference activates a projection step that requires the Windows SDK to be
      registered in the registry, which fails on a machine with only the .NET SDK
      installed (no Visual Studio). See the toolchain notes in
      docs/adr/0001-windows-desktop-architecture.md.
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Package assets ship in every configuration - they are ordinary content and
      cost nothing in an unpackaged build.
    -->
    <Content Include="Images\**\*.png" />
  </ItemGroup>

  <ItemGroup Condition="'$(WindowsPackageType)' != 'None'">
    <!--
      The manifest is included ONLY when packaging. It cannot be unconditional:
      the MSIX targets fail the build outright with "WindowsPackageType is set to
      None, but a AppxManifest is specified", so a manifest present in an
      unpackaged build breaks `dotnet build` and `dotnet run`.

      Packaging is driven from the command line rather than a second project:
        dotnet publish ... -p:WindowsPackageType=MSIX -p:GenerateAppxPackageOnBuild=true
      See docs/WINDOWS_DESKTOP.md and .github/workflows/windows-desktop.yml.
    -->
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenFlightDisplay.Core\OpenFlightDisplay.Core.csproj" />
    <ProjectReference Include="..\OpenFlightDisplay.Infrastructure\OpenFlightDisplay.Infrastructure.csproj" />
    <ProjectReference Include="..\OpenFlightDisplay.Persistence\OpenFlightDisplay.Persistence.csproj" />
    <ProjectReference Include="..\OpenFlightDisplay.Providers\OpenFlightDisplay.Providers.csproj" />
  </ItemGroup>

</Project>
