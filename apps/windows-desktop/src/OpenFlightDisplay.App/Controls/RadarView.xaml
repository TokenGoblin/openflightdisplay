<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="OpenFlightDisplay.App.Controls.RadarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!--
        Surface is the single source of truth for the plot's geometry. All
        drawing reads its ActualWidth/ActualHeight at draw time, and SizeChanged
        is handled here rather than on the UserControl so the size that triggers
        a redraw is the same size the redraw measures.
    -->
    <Grid
        x:Name="Surface"
        Background="{ThemeResource LayerFillColorAltBrush}"
        SizeChanged="OnSizeChanged"
        PointerWheelChanged="OnPointerWheelChanged">

        <!--
            Two canvases: the scale (rings, cardinals, observer) and the
            aircraft. Both are pinned to the top-left so Canvas.Left/Top mean
            exactly what the drawing code assumes - a Canvas has no desired size
            of its own, and left to stretch its origin depends on how the parent
            arranges a zero-size child.
        -->
        <!--
            Map backdrop, underneath everything. Dimmed so the rings and symbols
            stay the most legible thing on the plot: this is context, not the
            instrument. Clipped to the surface so tiles overhanging the edge do
            not spill into the rest of the window.
        -->
        <Canvas
            x:Name="MapCanvas"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Opacity="0.45"
            IsHitTestVisible="False" />

        <Canvas
            x:Name="ScaleCanvas"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            IsHitTestVisible="False" />

        <Canvas
            x:Name="AircraftCanvas"
            HorizontalAlignment="Left"
            VerticalAlignment="Top" />

        <!--
            The radar is a visual convenience, not the source of truth. Screen
            readers get the flight board, which carries the same aircraft with
            full per-row descriptions.
        -->
        <TextBlock
            x:Name="EmptyLabel"
            Text="No aircraft to plot"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Visibility="Collapsed" />

        <!--
            Zoom. On the plot rather than in Settings because it is a viewing
            control used constantly, not configuration - and because changing it
            must not restart the feed.
        -->
        <StackPanel
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="12"
            Spacing="4">
            <Button
                x:Name="ZoomInButton"
                Content="&#xE8A3;"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                Width="36" Height="36" Padding="0"
                AutomationProperties.Name="Zoom in"
                ToolTipService.ToolTip="Zoom in (scroll wheel)"
                Click="OnZoomIn" />
            <Button
                x:Name="ZoomOutButton"
                Content="&#xE71F;"
                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                Width="36" Height="36" Padding="0"
                AutomationProperties.Name="Zoom out"
                ToolTipService.ToolTip="Zoom out (scroll wheel)"
                Click="OnZoomOut" />
            <Border
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                CornerRadius="4"
                Padding="6,3">
                <TextBlock
                    x:Name="RangeLabel"
                    FontSize="11"
                    HorizontalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
