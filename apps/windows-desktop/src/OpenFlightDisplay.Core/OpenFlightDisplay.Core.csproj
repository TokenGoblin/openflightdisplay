<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The domain core. Deliberately targets plain net10.0, not net10.0-windows:
    this project must not be able to reference WinUI, HTTP, SQLite or Win32 even
    by accident. If a `using` here needs a platform, the code belongs in another
    project. See docs/adr/0001-windows-desktop-architecture.md section 1.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>OpenFlightDisplay.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

</Project>
