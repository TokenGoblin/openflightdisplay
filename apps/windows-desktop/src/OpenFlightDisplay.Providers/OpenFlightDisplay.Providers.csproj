<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Provider adapters. Targets plain net10.0 - nothing here needs Windows, and
    keeping it platform-free means the provider contract tests run anywhere.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>OpenFlightDisplay.Providers</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenFlightDisplay.Core\OpenFlightDisplay.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      BoundingCircle is an implementation detail of the provider, not part of its
      public surface, but it carries real geometry worth testing directly rather
      than only through a stubbed HTTP round-trip.
    -->
    <InternalsVisibleTo Include="OpenFlightDisplay.Providers.Tests" />
  </ItemGroup>

</Project>
